{
  "name": "@omnifi/chains-solana",
  "version": "0.1.0",
  "private": true,
  "description": "Solana programs and tests for OmniFi",
  "scripts": {
    "build": "anchor build",
    "test": "cargo test && ts-mocha -p ./tsconfig.json tests/integration.test.ts",
    "test:cargo": "cargo test",
    "test:integration": "ts-mocha -p ./tsconfig.json tests/integration.test.ts",
    "test:anchor": "anchor test",
    "lint": "cargo clippy -- -D warnings",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all -- --check"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.95.8"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "chai": "^4.4.1",
    "mocha": "^10.3.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.3.3"
  }
}
