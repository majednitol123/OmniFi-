# ==============================================================================
# OmniFi Local Development Environment Template
# Copy this file to .env.local for local overrides. NEVER commit secrets!
# ==============================================================================

# Node / App Environment
NODE_ENV=development
PORT=3000

# EVM Local Node (Anvil default)
EVM_RPC_URL=http://localhost:8545
EVM_CHAIN_ID=31337

# Solana Local Validator
SOLANA_RPC_URL=http://localhost:8899
SOLANA_WS_URL=ws://localhost:8900
SOLANA_CLUSTER=localnet

# PostgreSQL 16 (matches docker-compose.yml)
DATABASE_URL=postgresql://omnifi:omnifi_dev_password@localhost:5432/omnifi_dev
POSTGRES_USER=omnifi
POSTGRES_PASSWORD=omnifi_dev_password
POSTGRES_DB=omnifi_dev

# Redis 7 (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug

